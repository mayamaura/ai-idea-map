{
  "name": "ai-idea-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @ideamap/web dev",
    "dev:web": "pnpm --filter @ideamap/web dev",
    "dev:desktop": "pnpm --filter @ideamap/desktop tauri dev",
    "build": "tsc -b && pnpm --filter @ideamap/web build",
    "build:desktop": "tsc -b && node scripts/build-desktop.mjs",
    "preview": "pnpm --filter @ideamap/web preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "sync-version": "node scripts/sync-version.mjs",
    "check-version": "node scripts/sync-version.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.4",
    "eslint": "10.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0"
  }
}
