{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdeaMap",
  "version": "0.1.0",
  "identifier": "com.ideamap.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IdeaMap",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost data: blob:",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5174 http://localhost:5174 data: blob:",
      "capabilities": ["main-window", "file-access", "ai-http", "google-drive", "updater"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": ["ja-JP"]
      }
    },
    "fileAssociations": [
      {
        "ext": ["ideamap"],
        "name": "IdeaMap マップファイル",
        "description": "IdeaMap で作成したアイデアマップ",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzQUI0RkUwOERBN0FGRDcKUldUWHI2ZU40RStyODBEVEFmSlNnRHpNbWVvQkRPdVA5UG1PQzZ2RldoTlRqTDFKZkRwazFSSkUK",
      "endpoints": [
        "https://github.com/mayamaura/ai-idea-map/releases/latest/download/latest.json"
      ]
    }
  }
}
