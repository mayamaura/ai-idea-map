{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ai-http",
  "description": "AIプロバイダへの通信のみ許可する（Anthropic API とローカル Ollama）",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
