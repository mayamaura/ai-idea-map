# Google Cloud Console で「デスクトップアプリ」種別として発行した OAuth クライアントID。
# Web版の VITE_GOOGLE_CLIENT_ID（ウェブアプリケーション種別）とは別物で、使い回せない。
# 未設定でもアプリは動く（起動画面のドライブ欄が「未設定」の案内になるだけ）。
VITE_GOOGLE_DESKTOP_CLIENT_ID=xxxx.apps.googleusercontent.com

# 同じクライアントのシークレット。Cloud Console の認証情報画面か、
# ダウンロードした JSON の client_secret に入っている。
#
# 「デスクトップアプリ」種別では、PKCE を使っていてもトークン交換で要求される
# （省略すると 400 invalid_request "client_secret is missing." が返る）。
# 公開クライアントなので機密ではないが、.env はコミットしないこと。
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
